Practical 11: Student Grade Calculator

try:
    marks1 = float(input("Enter marks in Subject 1 (0-100): "))
    marks2 = float(input("Enter marks in Subject 2 (0-100): "))
    marks3 = float(input("Enter marks in Subject 3 (0-100): "))

    marks = [marks1, marks2, marks3]

    if any(mark < 0 or mark > 100 for mark in marks):
        raise ValueError("Marks must be between 0 and 100.")

    total = sum(marks)
    percentage = total / 3

    print("Total marks:", total, "/ 300")
    print("Percentage:", round(percentage, 2), "%")

except ValueError as e:
    print("Invalid marks:", e)


#Practical 12: ATM PIN Verification

CORRECT_PIN = "1234"
MAX_ATTEMPTS = 3

try:
    for attempt in range(1, MAX_ATTEMPTS + 1):
        pin = input("Enter your 4-digit PIN: ")

        if pin == CORRECT_PIN:
            print("PIN verified successfully.")
            break

        print("Incorrect PIN.")

    else:
        raise ValueError("Three unsuccessful attempts. Access denied.")

except ValueError as e:
    print("Error:", e)