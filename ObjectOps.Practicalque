class Student :
    def __init__(self,name,roll_no,trade ,marks): #contructor
        self.name=name
        self.roll_no=roll_no
        self.trade=trade
        self.marks=marks

    def display_details(self):
            print("Name:",self.name)
            print("Roll No:",self.roll_no)
            print("Trade:",self.trade)
            print("Marks:",self.marks)

    def check_result(self):
                if self.marks>=40:
                    print("Pass")
                else:
                    print("Fail")

    def percentage(self,total_marks):
          return (self.marks/total_marks)*100             

students1=Student("Princy",1,"AIPA",75)
students2=Student("Anushka",2,"AIPA",85)

students1.display_details()
students1.check_result()

students2.display_details()
students2.check_result()
print(students1.percentage(100),"%")
print(students2.percentage(100),"%")



VEHICLE DATA.

class Vehicle:
    def __init__(self, name, model, colour, price, speed):
        self.name = name
        self.model = model
        self.colour = colour
        self.price = price
        self.speed = speed

    def display_details(self):
        print("Name:", self.name)
        print("Model:", self.model)
        print("Colour:", self.colour)
        print("Price:", self.price)
        print("Speed:", self.speed, "km/h")

    def check_price(self):
        if self.price >= 1000000:
            print("Expensive car")
        else:
            print("Affordable car")

    def check_speed(self):
        if self.speed >= 150:
            print("High speed")
        else:
            print("Moderate speed")

    def discount(self, percent):
        amount = self.price * percent / 100
        final_price = self.price - amount

        print("Discount:", amount)
        print("Final Price:", final_price)


car1 = Vehicle("Thar", "LX", "Black", 1500000, 155)


car2 = Vehicle("Scorpio", "N", "White", 1800000, 165)



car1.display_details()
car1.check_price()
car1.check_speed()
car1.discount(10)


car2.display_details()
car2.check_price()
car2.check_speed()
car2.discount(5)

